generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

model Employee {
  id             String         @id @default(cuid())
  fullName       String
  jobTitle       String
  department     String
  country        String
  salary         Int
  currency       String
  employmentType EmploymentType
  hireDate       DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([country])
  @@index([jobTitle])
  @@index([country, jobTitle])
}
